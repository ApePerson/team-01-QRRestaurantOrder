// UML deployment view with protocols and trust boundaries.
digraph Dp {
  graph [rankdir=LR, fontname="Helvetica", dpi=200, nodesep=0.5, ranksep=0.9, pad=0.2];
  node  [shape=box3d, style=filled, fillcolor="#F4F6FA", color="#1F3A5F", fontname="Helvetica", fontsize=9.5];
  edge  [fontname="Helvetica", fontsize=8.5, color="#333333"];

  subgraph cluster_public { label="Trust zone 1 · Public internet — untrusted"; fontsize=10; style="dashed"; color="#B03A2E"; fontcolor="#B03A2E";
    phone [label=<«device»<BR/><B>Diner's phone</B><BR/>«execution environment» web browser<BR/>artifact: Customer Web App (C1)>];
  }
  subgraph cluster_rest { label="Trust zone 2 · Restaurant — logged-in staff"; fontsize=10; style="dashed"; color="#B26A00"; fontcolor="#7A4A00";
    tablet [label=<«device»<BR/><B>Staff tablet</B><BR/>«execution environment» web browser<BR/>artifact: Staff &amp; Manager Web App (C2)>];
    laptop [label=<«device»<BR/><B>Manager laptop</B><BR/>«execution environment» web browser<BR/>artifact: Staff &amp; Manager Web App (C2)>];
  }
  subgraph cluster_cloud { label="Trust zone 3 · Our cloud host — trusted"; fontsize=10; style="dashed"; color="#1F3A5F"; fontcolor="#1F3A5F";
    app [label=<«device» <B>Application server</B> (paid cloud plan)<BR/>«execution environment» Node.js runtime<BR/>artifact: qrmos-server (C3 – C8)>];
    db  [label=<«device» <B>Database server</B> (managed)<BR/>«execution environment» PostgreSQL<BR/>artifact: qrmos schema (C9)>];
  }
  subgraph cluster_third { label="Trust zone 4 · Third party"; fontsize=10; style="dashed"; color="#555555";
    gw [label=<«external system»<BR/><B>Payment gateway</B><BR/>hosted checkout page>];
  }
  phone -> app  [label="HTTPS (TLS 1.2+)\n+ WSS push", dir=both];
  tablet -> app [label="HTTPS + WSS\nsession cookie", dir=both];
  laptop -> app [label="HTTPS\nsession cookie", dir=both];
  app -> db     [label="SQL over TLS\nprivate network only", dir=both];
  app -> gw     [label="HTTPS API (secret key)\n← signed webhook", dir=both];
  phone -> gw   [label="HTTPS redirect: card typed\non gateway page only", style=dashed];
}
